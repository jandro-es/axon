# Consumed by Scripts/package_app.sh, compile_and_run.sh and make_appcast.sh.
# BUILD_NUMBER must increase on every release — Sparkle compares CFBundleVersion.
APP_NAME=Axon
BUNDLE_ID=com.axon.companion
MACOS_MIN_VERSION=26.0
MENU_BAR_APP=1
MARKETING_VERSION=0.1.0
BUILD_NUMBER=1
EXECUTABLE_NAME=Companion

# Sparkle 2 (CFR-81). SUPublicEDKey is the PUBLIC half of the EdDSA key pair;
# the private half lives only in the release machine's keychain and must be
# backed up -- losing it means existing installs will reject every future
# update, with no recovery path but a manual reinstall.
SPARKLE_PUBLIC_KEY=et0lzflvRM9162tw+MgS+I97gNjSo5AVRiDv4C/wzxQ=
# NOT releases/latest/download/: `latest` resolves across ALL releases, so the
# next daemon v* release would take it over and 404 this feed permanently for
# every installed copy. The repo path is stable regardless of release order.
SPARKLE_FEED_URL=https://raw.githubusercontent.com/jandro-es/axon/main/apps/companion/appcast/companion-appcast.xml
SPARKLE_DOWNLOAD_URL_PREFIX=https://github.com/jandro-es/axon/releases/download/companion-v${MARKETING_VERSION}/
